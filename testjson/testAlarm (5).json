            "sync": false,
            "parameters": [],
            "mode": "CLIENT",
            "code": "const voiceOn = $getTag('t_03af4b71-c18944fe' /* FUXA - voiceOn */);\n\nconsole.log(voiceOn);\nif(voiceOn){\n  $setTag('t_03af4b71-c18944fe' /* FUXA - voiceOn */, false);\n  const message = $getTag('t_001ff92a-392b44fe' /* FUXA - voiceMessage */);\n  \n  console.log(message);\n  const voice = speechSynthesis.getVoices().find(v => v.lang === 'zh-TW' && v.localService);\n  const u = new SpeechSynthesisUtterance(message);\n  if (voice) u.voice = voice;\n  u.lang = 'zh-TW';\n  speechSynthesis.speak(u);\n}\n\n",
